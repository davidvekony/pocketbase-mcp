{
  "name": "pocketbase-server",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pocketbase-server": "./build/index.js"
  },
  "packageManager": "pnpm@12.4.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12 <13",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "tsc",
    "prestart": "pnpm run build",
    "start": "node --env-file-if-exists=.env build/index.js",
    "dev": "tsc -w",
    "test": "pnpm test:unit",
    "test:unit": "pnpm run build && node --test test/",
    "test:integration": "pnpm run build && RUN_INTEGRATION=1 node --test test/integration.test.mjs",
    "test:all": "pnpm run build && RUN_INTEGRATION=1 node --test test/"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "pocketbase": "^0.28.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "fallow": "^3.25.0",
    "typescript": "^7.0.2"
  }
}
