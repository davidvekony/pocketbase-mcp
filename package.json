{
  "name": "pocketbase-server",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pocketbase-server": "./build/index.js"
  },
  "packageManager": "pnpm@12.4.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12 <13",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "tsc",
    "prestart": "pnpm run build",
    "start": "node --env-file-if-exists=.env build/index.js",
    "dev": "tsc -w"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "pocketbase": "^0.28.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2"
  }
}
